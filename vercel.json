{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "proxy": {
    "entrypoint": "proxy.js",
    "matcher": [
      "/value-calculator/:path*",
      "/value-calculator.html",
      "/rollout/:path*",
      "/rollout.html",
      "/executive-briefing/:path*",
      "/executive-briefing.html",
      "/demo-script/:path*",
      "/demo-script.html",
      "/platform-overview/:path*",
      "/platform-overview.html",
      "/public/value-calculator/:path*",
      "/public/value-calculator.html",
      "/public/executive-briefing/:path*",
      "/public/executive-briefing.html"
    ]
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/help",
      "destination": "https://app.cleanspacestay.com/help",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*).css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
